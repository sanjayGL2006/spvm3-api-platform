# Copy to .env and fill in. Never commit the real .env file.
DATABASE_URL=mysql://user:password@localhost:3306/spvm3_platform

# Both must be long random strings (32+ characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Used to hash API keys and IP addresses. If you change it, all existing API keys stop working.
API_KEY_PEPPER=

# Use 1 in production (https). Use 0 only for local testing over http.
COOKIE_SECURE=1
# Set to 1 if nginx or another proxy sits in front of the app
BEHIND_PROXY=0

# Your public dashboard address(es), comma separated. Needed if the proxy changes the Host header.
TRUSTED_ORIGINS=
# Websites allowed to call /v1 from a browser. Empty = server-to-server only. "*" = any website.
V1_CORS_ORIGINS=

MAX_ACTIVE_KEYS_PER_USER=10

# Optional: answer /v1/ask with a local LLM via Ollama. Empty = answer from the best matching entry.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Only for docker compose: the database password (used by both containers)
DB_PASSWORD=
